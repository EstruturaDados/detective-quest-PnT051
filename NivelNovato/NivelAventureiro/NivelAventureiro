#include <stdio.h>
#include <stdlib.h>
#include <string.h>


// ==========================================================
// ESTRUTURA DA ÁRVORE DA MANSÃO
// ==========================================================

typedef struct Sala {
    char nome[50];

    struct Sala *esquerda;
    struct Sala *direita;
} Sala;


// ==========================================================
// ESTRUTURA DA ÁRVORE DE BUSCA (BST) DE PISTAS
// ==========================================================

typedef struct Pista {
    char descricao[100];

    struct Pista *esquerda;
    struct Pista *direita;
} Pista;


// ==========================================================
// FUNÇÃO PARA CRIAR UMA SALA
// ==========================================================

Sala* criarSala(const char *nome) {

    Sala *novaSala = (Sala*) malloc(sizeof(Sala));

    if (novaSala == NULL) {
        printf("Erro ao criar sala.\n");
        exit(1);
    }

    strcpy(novaSala->nome, nome);

    novaSala->esquerda = NULL;
    novaSala->direita = NULL;

    return novaSala;
}


// ==========================================================
// FUNÇÃO PARA CRIAR UMA PISTA
// ==========================================================

Pista* criarPista(const char *descricao) {

    Pista *novaPista = (Pista*) malloc(sizeof(Pista));

    if (novaPista == NULL) {
        printf("Erro ao criar pista.\n");
        exit(1);
    }

    strcpy(novaPista->descricao, descricao);

    novaPista->esquerda = NULL;
    novaPista->direita = NULL;

    return novaPista;
}


// ==========================================================
// INSERÇÃO DE PISTA NA ÁRVORE BST
// ==========================================================

Pista* inserir(Pista *raiz, const char *descricao) {

    // Se a árvore estiver vazia, cria a primeira pista
    if (raiz == NULL) {
        return criarPista(descricao);
    }

    // Pista menor: vai para a esquerda
    if (strcmp(descricao, raiz->descricao) < 0) {

        raiz->esquerda =
            inserir(raiz->esquerda, descricao);
    }

    // Pista maior: vai para a direita
    else if (strcmp(descricao, raiz->descricao) > 0) {

        raiz->direita =
            inserir(raiz->direita, descricao);
    }

    // Se for igual, não insere novamente
    else {
        printf("\nPista ja encontrada: %s\n", descricao);
    }

    return raiz;
}


// ==========================================================
// BUSCA DE UMA PISTA NA BST
// ==========================================================

Pista* buscar(Pista *raiz, const char *descricao) {

    if (raiz == NULL) {
        return NULL;
    }

    // Pista encontrada
    if (strcmp(descricao, raiz->descricao) == 0) {
        return raiz;
    }

    // Procura na esquerda
    if (strcmp(descricao, raiz->descricao) < 0) {

        return buscar(raiz->esquerda, descricao);
    }

    // Procura na direita
    return buscar(raiz->direita, descricao);
}


// ==========================================================
// EXIBE AS PISTAS EM ORDEM ALFABÉTICA
// ==========================================================

void emOrdem(Pista *raiz) {

    if (raiz == NULL) {
        return;
    }

    emOrdem(raiz->esquerda);

    printf("- %s\n", raiz->descricao);

    emOrdem(raiz->direita);
}


// ==========================================================
// VERIFICA SE A SALA POSSUI UMA PISTA
// ==========================================================

void verificarPista(Sala *sala, Pista **arvorePistas) {

    if (strcmp(sala->nome, "Biblioteca") == 0) {

        printf("\n*** PISTA ENCONTRADA! ***\n");
        printf("Na Biblioteca existe um livro com uma mensagem secreta.\n");

        *arvorePistas =
            inserir(*arvorePistas,
                    "Livro com mensagem secreta");
    }

    else if (strcmp(sala->nome, "Escritorio") == 0) {

        printf("\n*** PISTA ENCONTRADA! ***\n");
        printf("Voce encontrou uma carta sobre a mesa.\n");

        *arvorePistas =
            inserir(*arvorePistas,
                    "Carta sobre a mesa");
    }

    else if (strcmp(sala->nome, "Sala de Jantar") == 0) {

        printf("\n*** PISTA ENCONTRADA! ***\n");
        printf("Uma taça quebrada possui marcas suspeitas.\n");

        *arvorePistas =
            inserir(*arvorePistas,
                    "Taca quebrada");
    }

    else if (strcmp(sala->nome, "Cofre Secreto") == 0) {

        printf("\n*** PISTA ENCONTRADA! ***\n");
        printf("Dentro do cofre existe uma chave misteriosa.\n");

        *arvorePistas =
            inserir(*arvorePistas,
                    "Chave misteriosa");
    }

    else if (strcmp(sala->nome, "Quarto de Hospedes") == 0) {

        printf("\n*** PISTA ENCONTRADA! ***\n");
        printf("Uma fotografia antiga foi encontrada.\n");

        *arvorePistas =
            inserir(*arvorePistas,
                    "Fotografia antiga");
    }

    else if (strcmp(sala->nome, "Cozinha") == 0) {

        printf("\n*** PISTA ENCONTRADA! ***\n");
        printf("Existe uma faca com uma marca estranha.\n");

        *arvorePistas =
            inserir(*arvorePistas,
                    "Faca com marca estranha");
    }
}


// ==========================================================
// EXPLORAÇÃO DA MANSÃO
// ==========================================================

void explorarSalas(Sala *salaAtual, Pista **arvorePistas) {

    char opcao;

    while (salaAtual != NULL) {

        printf("\n========================================\n");
        printf("          DETECTIVE QUEST\n");
        printf("========================================\n");

        printf("Sala atual: %s\n", salaAtual->nome);


        // Verifica se existe alguma pista na sala
        verificarPista(salaAtual, arvorePistas);


        // Verifica se chegou a uma folha
        if (salaAtual->esquerda == NULL &&
            salaAtual->direita == NULL) {

            printf("\nVoce chegou ao fim deste caminho!\n");

            break;
        }


        printf("\nEscolha seu caminho:\n");

        if (salaAtual->esquerda != NULL) {

            printf("e - Esquerda: %s\n",
                   salaAtual->esquerda->nome);
        }

        if (salaAtual->direita != NULL) {

            printf("d - Direita: %s\n",
                   salaAtual->direita->nome);
        }

        printf("p - Ver pistas encontradas\n");
        printf("s - Sair da exploracao\n");

        printf("\nOpcao: ");
        scanf(" %c", &opcao);


        // ==================================================
        // IR PARA A ESQUERDA
        // ==================================================

        if (opcao == 'e' || opcao == 'E') {

            if (salaAtual->esquerda != NULL) {

                salaAtual = salaAtual->esquerda;
            }
            else {

                printf("\nNao existe sala a esquerda.\n");
            }
        }


        // ==================================================
        // IR PARA A DIREITA
        // ==================================================

        else if (opcao == 'd' || opcao == 'D') {

            if (salaAtual->direita != NULL) {

                salaAtual = salaAtual->direita;
            }
            else {

                printf("\nNao existe sala a direita.\n");
            }
        }


        // ==================================================
        // MOSTRAR PISTAS
        // ==================================================

        else if (opcao == 'p' || opcao == 'P') {

            printf("\n========================================\n");
            printf("          PISTAS ENCONTRADAS\n");
            printf("========================================\n");

            if (*arvorePistas == NULL) {

                printf("Nenhuma pista encontrada ainda.\n");
            }
            else {

                emOrdem(*arvorePistas);
            }
        }


        // ==================================================
        // SAIR
        // ==================================================

        else if (opcao == 's' || opcao == 'S') {

            printf("\nExploracao encerrada.\n");

            break;
        }


        // ==================================================
        // OPÇÃO INVÁLIDA
        // ==================================================

        else {

            printf("\nOpcao invalida!\n");
        }
    }
}


// ==========================================================
// LIBERA A ÁRVORE DA MANSÃO
// ==========================================================

void liberarSalas(Sala *raiz) {

    if (raiz == NULL) {
        return;
    }

    liberarSalas(raiz->esquerda);
    liberarSalas(raiz->direita);

    free(raiz);
}


// ==========================================================
// LIBERA A ÁRVORE DE PISTAS
// ==========================================================

void liberarPistas(Pista *raiz) {

    if (raiz == NULL) {
        return;
    }

    liberarPistas(raiz->esquerda);
    liberarPistas(raiz->direita);

    free(raiz);
}


// ==========================================================
// PROGRAMA PRINCIPAL
// ==========================================================

int main() {

    // ======================================================
    // CRIAÇÃO DA ÁRVORE DA MANSÃO
    // ======================================================

    Sala *hall =
        criarSala("Hall de Entrada");

    hall->esquerda =
        criarSala("Biblioteca");

    hall->direita =
        criarSala("Sala de Estar");


    hall->esquerda->esquerda =
        criarSala("Escritorio");

    hall->esquerda->direita =
        criarSala("Sala de Leitura");


    hall->direita->esquerda =
        criarSala("Sala de Jantar");

    hall->direita->direita =
        criarSala("Cozinha");


    hall->esquerda->esquerda->esquerda =
        criarSala("Cofre Secreto");

    hall->esquerda->esquerda->direita =
        criarSala("Quarto de Hospedes");


    hall->direita->direita->esquerda =
        criarSala("Despensa");

    hall->direita->direita->direita =
        criarSala("Adega");


    // ======================================================
    // CRIAÇÃO DA ÁRVORE DE PISTAS
    // ======================================================

    Pista *arvorePistas = NULL;


    // ======================================================
    // INÍCIO DO JOGO
    // ======================================================

    printf("\n");
    printf("**********************************************\n");
    printf("*                                            *\n");
    printf("*       DETECTIVE QUEST - AVENTUREIRO        *\n");
    printf("*                                            *\n");
    printf("**********************************************\n");

    printf("\nBem-vindo, detetive!\n");
    printf("Explore a mansao e encontre todas as pistas.\n");


    // ======================================================
    // INICIA A EXPLORAÇÃO
    // ======================================================

    explorarSalas(hall, &arvorePistas);


    // ======================================================
    // MOSTRA TODAS AS PISTAS AO FINAL
    // ======================================================

    printf("\n========================================\n");
    printf("        TODAS AS PISTAS ENCONTRADAS\n");
    printf("========================================\n");

    if (arvorePistas == NULL) {

        printf("Nenhuma pista foi encontrada.\n");
    }
    else {

        emOrdem(arvorePistas);
    }


    // ======================================================
    // LIBERA A MEMÓRIA
    // ======================================================

    liberarSalas(hall);
    liberarPistas(arvorePistas);


    printf("\n========================================\n");
    printf("Jogo encerrado!\n");
    printf("Memoria liberada com sucesso.\n");
    printf("========================================\n");


    return 0;
}