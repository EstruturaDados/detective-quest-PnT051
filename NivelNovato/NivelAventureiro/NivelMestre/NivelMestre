        criarSala("Sala de Leitura");


    hall->direita->esquerda =
        criarSala("Sala de Jantar");

    hall->direita->direita =
        criarSala("Cozinha");


    hall->esquerda->esquerda->esquerda =
        criarSala("Cofre Secreto");

    hall->esquerda->esquerda->direita =
        criarSala("Quarto de Hospedes");


    hall->direita->direita->esquerda =
        criarSala("Despensa");

    hall->direita->direita->direita =
        criarSala("Adega");


    // ======================================================
    // CRIAÇÃO DA BST DE PISTAS
    // ======================================================

    Pista *arvorePistas = NULL;


    // ======================================================
    // CRIAÇÃO DA TABELA HASH
    // ======================================================

    Associacao *tabelaHash[TAM_HASH];

    inicializarHash(tabelaHash);


    // ======================================================
    // INÍCIO DO JOGO
    // ======================================================

    printf("\n");
    printf("**********************************************\n");
    printf("*                                            *\n");
    printf("*          DETECTIVE QUEST                   *\n");
    printf("*             NIVEL MESTRE                   *\n");
    printf("*                                            *\n");
    printf("**********************************************\n");

    printf("\nBem-vindo, detetive!\n");
    printf("Explore a mansao, encontre pistas e descubra\n");
    printf("quem e o principal suspeito.\n");


    // ======================================================
    // EXPLORAÇÃO
    // ======================================================

    explorarSalas(
        hall,
        &arvorePistas,
        tabelaHash
    );


    // ======================================================
    // MOSTRA TODAS AS PISTAS
    // ======================================================

    printf("\n========================================\n");
    printf("          PISTAS ENCONTRADAS\n");
    printf("========================================\n");

    if (arvorePistas == NULL) {
        printf("Nenhuma pista encontrada.\n");
    }
    else {
        emOrdem(arvorePistas);
    }


    // ======================================================
    // MOSTRA TODAS AS ASSOCIAÇÕES
    // ======================================================

    mostrarAssociacoes(tabelaHash);


    // ======================================================
    // RESULTADO FINAL
    // ======================================================

    suspeitoMaisCitado(tabelaHash);


    // ======================================================
    // LIBERA MEMÓRIA
    // ======================================================

    liberarSalas(hall);

    liberarPistas(arvorePistas);

    liberarHash(tabelaHash);


    printf("\n========================================\n");
    printf("      INVESTIGACAO ENCERRADA!\n");
    printf("========================================\n");

    return 0;
}