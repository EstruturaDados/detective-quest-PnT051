#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define TAM_HASH 10


// ==========================================================
// ESTRUTURA DA ÁRVORE BINÁRIA DA MANSÃO
// ==========================================================

typedef struct Sala {
    char nome[50];

    struct Sala *esquerda;
    struct Sala *direita;
} Sala;


// ==========================================================
// ESTRUTURA DA BST DE PISTAS
// ==========================================================

typedef struct Pista {
    char descricao[100];

    struct Pista *esquerda;
    struct Pista *direita;
} Pista;


// ==========================================================
// ESTRUTURA DA TABELA HASH
// Cada elemento relaciona:
// PISTA -> SUSPEITO
// ==========================================================

typedef struct Associacao {
    char pista[100];
    char suspeito[50];

    struct Associacao *proximo;
} Associacao;


// ==========================================================
// CRIA UMA NOVA SALA
// ==========================================================

Sala* criarSala(const char *nome) {

    Sala *novaSala = (Sala*) malloc(sizeof(Sala));

    if (novaSala == NULL) {
        printf("Erro ao criar sala.\n");
        exit(1);
    }

    strcpy(novaSala->nome, nome);

    novaSala->esquerda = NULL;
    novaSala->direita = NULL;

    return novaSala;
}


// ==========================================================
// CRIA UMA NOVA PISTA
// ==========================================================

Pista* criarPista(const char *descricao) {

    Pista *novaPista = (Pista*) malloc(sizeof(Pista));

    if (novaPista == NULL) {
        printf("Erro ao criar pista.\n");
        exit(1);
    }

    strcpy(novaPista->descricao, descricao);

    novaPista->esquerda = NULL;
    novaPista->direita = NULL;

    return novaPista;
}


// ==========================================================
// INSERE PISTA NA BST
// ==========================================================

Pista* inserir(Pista *raiz, const char *descricao) {

    if (raiz == NULL) {
        return criarPista(descricao);
    }

    if (strcmp(descricao, raiz->descricao) < 0) {

        raiz->esquerda =
            inserir(raiz->esquerda, descricao);
    }
    else if (strcmp(descricao, raiz->descricao) > 0) {

        raiz->direita =
            inserir(raiz->direita, descricao);
    }

    return raiz;
}


// ==========================================================
// BUSCA UMA PISTA NA BST
// ==========================================================

Pista* buscar(Pista *raiz, const char *descricao) {

    if (raiz == NULL) {
        return NULL;
    }

    if (strcmp(descricao, raiz->descricao) == 0) {
        return raiz;
    }

    if (strcmp(descricao, raiz->descricao) < 0) {
        return buscar(raiz->esquerda, descricao);
    }

    return buscar(raiz->direita, descricao);
}


// ==========================================================
// EXIBE AS PISTAS EM ORDEM ALFABÉTICA
// ==========================================================

void emOrdem(Pista *raiz) {

    if (raiz == NULL) {
        return;
    }

    emOrdem(raiz->esquerda);

    printf("- %s\n", raiz->descricao);

    emOrdem(raiz->direita);
}


// ==========================================================
// FUNÇÃO HASH
// Utiliza a soma dos caracteres da pista
// ==========================================================

int funcaoHash(const char *pista) {

    int soma = 0;

    for (int i = 0; pista[i] != '\0'; i++) {
        soma += (unsigned char)pista[i];
    }

    return soma % TAM_HASH;
}


// ==========================================================
// INICIALIZA A TABELA HASH
// ==========================================================

void inicializarHash(Associacao *tabela[]) {

    for (int i = 0; i < TAM_HASH; i++) {
        tabela[i] = NULL;
    }
}


// ==========================================================
// INSERE PISTA -> SUSPEITO NA TABELA HASH
// Utiliza encadeamento para tratar colisões
// ==========================================================

void inserirNaHash(
    Associacao *tabela[],
    const char *pista,
    const char *suspeito
) {

    int indice = funcaoHash(pista);

    Associacao *nova =
        (Associacao*) malloc(sizeof(Associacao));

    if (nova == NULL) {
        printf("Erro ao criar associacao.\n");
        exit(1);
    }

    strcpy(nova->pista, pista);
    strcpy(nova->suspeito, suspeito);

    nova->proximo = NULL;


    // Se a posição estiver vazia
    if (tabela[indice] == NULL) {

        tabela[indice] = nova;
    }
    else {

        // Encadeamento para resolver colisões
        Associacao *atual = tabela[indice];

        while (atual->proximo != NULL) {
            atual = atual->proximo;
        }

        atual->proximo = nova;
    }
}


// ==========================================================
// MOSTRA TODAS AS ASSOCIAÇÕES PISTA -> SUSPEITO
// ==========================================================

void mostrarAssociacoes(Associacao *tabela[]) {

    printf("\n========================================\n");
    printf("       PISTAS E SUSPEITOS\n");
    printf("========================================\n");

    int encontrou = 0;

    for (int i = 0; i < TAM_HASH; i++) {

        Associacao *atual = tabela[i];

        while (atual != NULL) {

            printf("Pista: %-30s -> Suspeito: %s\n",
                   atual->pista,
                   atual->suspeito);

            atual = atual->proximo;

            encontrou = 1;
        }
    }

    if (!encontrou) {
        printf("Nenhuma associacao encontrada.\n");
    }
}


// ==========================================================
// MOSTRA TODAS AS PISTAS RELACIONADAS A UM SUSPEITO
// ==========================================================

void mostrarPistasDoSuspeito(
    Associacao *tabela[],
    const char *suspeito
) {

    printf("\n========================================\n");
    printf("Pistas relacionadas a: %s\n", suspeito);
    printf("========================================\n");

    int quantidade = 0;

    for (int i = 0; i < TAM_HASH; i++) {

        Associacao *atual = tabela[i];

        while (atual != NULL) {

            if (strcmp(atual->suspeito, suspeito) == 0) {

                printf("- %s\n", atual->pista);

                quantidade++;
            }

            atual = atual->proximo;
        }
    }

    if (quantidade == 0) {
        printf("Nenhuma pista relacionada a este suspeito.\n");
    }
}


// ==========================================================
// ENCONTRA O SUSPEITO MAIS CITADO
// ==========================================================

void suspeitoMaisCitado(Associacao *tabela[]) {

    char suspeitos[100][50];
    int quantidades[100];

    int totalSuspeitos = 0;


    // Inicializa os contadores
    for (int i = 0; i < 100; i++) {
        quantidades[i] = 0;
    }


    // Percorre toda a tabela hash
    for (int i = 0; i < TAM_HASH; i++) {

        Associacao *atual = tabela[i];

        while (atual != NULL) {

            int encontrado = -1;

            // Verifica se o suspeito já foi registrado
            for (int j = 0; j < totalSuspeitos; j++) {

                if (strcmp(
                    suspeitos[j],
                    atual->suspeito
                ) == 0) {

                    encontrado = j;
                    break;
                }
            }


            // Se for um novo suspeito
            if (encontrado == -1) {

                strcpy(
                    suspeitos[totalSuspeitos],
                    atual->suspeito
                );

                quantidades[totalSuspeitos] = 1;

                totalSuspeitos++;
            }
            else {

                quantidades[encontrado]++;
            }

            atual = atual->proximo;
        }
    }


    // Não existem suspeitos
    if (totalSuspeitos == 0) {

        printf("\nNenhum suspeito possui pistas associadas.\n");

        return;
    }


    // Descobre quem possui mais pistas
    int maior = 0;

    for (int i = 1; i < totalSuspeitos; i++) {

        if (quantidades[i] > quantidades[maior]) {
            maior = i;
        }
    }


    printf("\n========================================\n");
    printf("          RESULTADO DA INVESTIGACAO\n");
    printf("========================================\n");

    printf("Suspeito mais citado: %s\n",
           suspeitos[maior]);

    printf("Quantidade de pistas: %d\n",
           quantidades[maior]);

    printf("\nConclusao: %s e o principal suspeito!\n",
           suspeitos[maior]);
}


