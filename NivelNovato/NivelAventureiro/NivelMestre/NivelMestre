// PROGRAMA PRINCIPAL
// ==========================================================

int main() {

    // ======================================================
    // CRIAÇÃO DA ÁRVORE DA MANSÃO
    // ======================================================

    Sala *hall =
        criarSala("Hall de Entrada");

    hall->esquerda =
        criarSala("Biblioteca");

    hall->direita =
        criarSala("Sala de Estar");


    hall->esquerda->esquerda =
        criarSala("Escritorio");

